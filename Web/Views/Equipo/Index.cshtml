@model IEnumerable<DTOs.DTOEquipos.DTOEquipo>

@{
    ViewData["Title"] = "Listado de equipos";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2 class="mb-0">Equipos</h2>
            <small class="text-muted">Listado de equipos disponibles</small>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="btn-group" role="group" aria-label="Crear equipo">
                <a asp-action="CreateCamara" class="btn btn-primary btn-sm">Crear Cámara</a>
                <a asp-action="CreateTelescopio" class="btn btn-primary btn-sm">Crear Telescopio</a>
                <a asp-action="CreateMontura" class="btn btn-primary btn-sm">Crear Montura</a>
                <a asp-action="CreateOcular" class="btn btn-primary btn-sm">Crear Ocular</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tipo</th>
                            <th>@Html.DisplayNameFor(model => model.Marca)</th>
                            <th>@Html.DisplayNameFor(model => model.Modelo)</th>
                            <th class="text-end">@Html.DisplayNameFor(model => model.Stock)</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TipoEquipo</td>
                                <td>@Html.DisplayFor(modelItem => item.Marca)</td>
                                <td>@Html.DisplayFor(modelItem => item.Modelo)</td>
                                <td class="text-end">@Html.DisplayFor(modelItem => item.Stock)</td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalles</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No hay equipos para mostrar.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
