@model DTOs.DTOEquipos.DTOCamara

@{
    ViewData["Title"] = "CreateCamara";
}

<h1>CreateCamara</h1>

<h4>Camara</h4>
<hr />
<div class="row">

    <div class="col-md-4">
        <form asp-action="CreateCamara">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Sensor" class="control-label"></label>
                <select asp-for="SensorId" class="form-control">
                    <option value="">Seleccione un sensor</option>
                    @if (Model?.Sensores != null)
                    {
                        for (var i = 0; i < Model.Sensores.Count; i++)
                        {
                            <option value="@i">@Model.Sensores[i]</option>
                        }
                    }
                </select>
                <span asp-validation-for="SensorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Resolucion" class="control-label"></label>
                <input asp-for="Resolucion" class="form-control" />
                <span asp-validation-for="Resolucion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TamPixel" class="control-label"></label>
                <input asp-for="TamPixel" class="form-control" />
                <span asp-validation-for="TamPixel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Marca" class="control-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Modelo" class="control-label"></label>
                <input asp-for="Modelo" class="form-control" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Stock" class="control-label"></label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
