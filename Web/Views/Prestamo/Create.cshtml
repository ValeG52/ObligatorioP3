@model DTOs.DTOPrestamos.DTOPrestamo


@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Prestamo</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Inicio" class="control-label"></label>
                <input asp-for="Inicio" class="form-control" />
                <span asp-validation-for="Inicio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Fin" class="control-label"></label>
                <input asp-for="Fin" class="form-control" />
                <span asp-validation-for="Fin" class="text-danger"></span>
            </div>
           <div class="form-group">
                <label asp-for="CamaraId" class="control-label"></label>
                <select asp-for="CamaraId" class="form-control">
                    @if (Model.Camaras != null)
                    {
                        foreach(var tema in Model.Camaras)
                        {
                            <option value="@tema.Id">@tema.Marca @tema.Modelo</option>
                        }
                    }
                </select>
                <span asp-validation-for="CamaraId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TelescopioId" class="control-label"></label>
                <select asp-for="TelescopioId" class="form-control">
                    @if (Model.Telescopios != null)
                    {
                        foreach (var tema in Model.Telescopios)
                        {
                            <option value="@tema.Id">@tema.Marca @tema.Modelo</option>
                        }
                    }
                </select>
                <span asp-validation-for="TelescopioId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MonturaId" class="control-label"></label>
                <select asp-for="MonturaId" class="form-control">
                    @if (Model.Monturas != null)
                    {
                        foreach (var tema in Model.Monturas)
                        {
                            <option value="@tema.Id">@tema.Marca @tema.Modelo</option>
                        }
                    }
                </select>
                <span asp-validation-for="MonturaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OcularId" class="control-label"></label>
                <select asp-for="OcularId" class="form-control">
                    @if (Model.Oculares != null)
                    {
                        foreach (var tema in Model.Oculares)
                        {
                            <option value="@tema.Id">@tema.Marca @tema.Modelo</option>
                        }
                    }
                </select>
                <span asp-validation-for="OcularId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UsuarioId" class="control-label"></label>
                <select asp-for="UsuarioId" class="form-control">
                    @if (Model.Usuarios != null)
                    {
                        foreach (var tema in Model.Usuarios)
                        {
                            <option value="@tema.Id">@tema.Nombre</option>
                        }
                    }
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
