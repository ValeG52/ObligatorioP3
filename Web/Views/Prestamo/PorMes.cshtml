@model IEnumerable<DTOs.DTOPrestamos.DTOListadoPrestamo>

@{
    ViewData["Title"] = "Préstamos por mes";
}

<div class="container mt-4">
    <h2>Préstamos del mes</h2>

    <div class="card p-3 mt-3">
        <form method="post" asp-action="PorMes">
            <div class="row g-2">
                <div class="col-md-2">
                    <label class="form-label">Mes</label>
                    <input type="number" name="mes" min="1" max="12" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Año</label>
                    <input type="number" name="anio" min="2000" max="2100" class="form-control" required />
                </div>

                <div class="col-md-3 align-self-end">
                    <button type="submit" class="btn btn-primary">Buscar</button>
                </div>
            </div>
        </form>

        <div class="mt-3">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Estado</th>
                                <th>Atrasado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                var atrasado = (string.Equals(p.Estado, "EN PRÉSTAMO", StringComparison.OrdinalIgnoreCase) && DateTime.Now > p.Fin) ? "Sí" : "No";
                                <tr>
                                    <td>@p.Inicio.ToString("dd/MM/yyyy")</td>
                                    <td>@p.Fin.ToString("dd/MM/yyyy")</td>
                                    <td>@p.Estado</td>
                                    <td>@atrasado</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted">No hay préstamos para mostrar en el mes/año seleccionado.</div>
            }
        </div>
    </div>
</div>
