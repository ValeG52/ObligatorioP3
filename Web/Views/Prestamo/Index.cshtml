@model IEnumerable<DTOs.DTOPrestamos.DTOListadoPrestamo>

@{
    ViewData["Title"] = "Listado de préstamos";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2 class="mb-0">Préstamos</h2>
            <small class="text-muted">Listado de préstamos</small>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-action="Create" class="btn btn-primary btn-sm">Crear Préstamo</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.First().Inicio)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Fin)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Estado)</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Inicio)</td>
                                <td>@Html.DisplayFor(modelItem => item.Fin)</td>
                                <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                                
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">No hay préstamos para mostrar.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
