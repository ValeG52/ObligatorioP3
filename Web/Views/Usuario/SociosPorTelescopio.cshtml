@model IEnumerable<DTOs.DTOUsuarios.DTOListadoUsuario>

@{
    ViewData["Title"] = "Socios por telescopio";
    var telescopios = ViewBag.Telescopios as IEnumerable<DTOs.DTOEquipos.DTOListadoTelescopio> ?? new List<DTOs.DTOEquipos.DTOListadoTelescopio>();
}

<div class="container mt-4">
    <h2>Socios por Telescopio</h2>

    <div class="card p-3 mt-3">
        <form method="post" asp-action="SociosPorTelescopio">
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label">Telescopio</label>
                    <select name="idTelescopio" class="form-select">
                        <option value="">-- Seleccione --</option>
                        @foreach (var t in telescopios)
                        {
                            <option value="@t.Id">@t.Marca @t.Modelo</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 align-self-end">
                    <button type="submit" class="btn btn-primary">Buscar</button>
                </div>
            </div>
        </form>

        <div class="mt-3">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Id</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td>@s.Nombre</td>
                                    <td>@s.Id</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted">No hay socios que hayan solicitado ese telescopio.</div>
            }
        </div>
    </div>
</div>
