@model IEnumerable<CasosDeUso.DTOs.DTOAuditoria.DTOAuditoria>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Usuario coordinador</th>
                    <th>Acción</th>
                    <th>Préstamo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@a.NombreUsu</td>
                        <td>@a.Accion</td>
                        <td><a asp-controller="Auditoria" asp-action="Details" asp-route-idPrestamo="@a.IDPrestamo">Ver préstamo</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-muted">No hay auditorías para este préstamo.</div>
}
